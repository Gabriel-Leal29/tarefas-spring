{
  "info": {
    "name": "Tarefas API",
    "description": "Testes da API de tarefas e categorias (Spring Boot + MySQL no Docker). Suba o ambiente com 'docker compose up -d' e use 'Run collection' para executar tudo em ordem: as pastas dependem umas das outras (os ids criados ficam nas variáveis da coleção).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "id", "value": "1" },
    { "key": "categoriaId", "value": "1" },
    { "key": "categoriaNome", "value": "" }
  ],
  "item": [
    {
      "name": "1. Categorias",
      "item": [
        {
          "name": "Criar categoria (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Header Location presente', () => pm.response.to.have.header('Location'));",
            "pm.test('Id gerado pelo banco', () => pm.expect(pm.response.json().id).to.be.a('number'));",
            "pm.collectionVariables.set('categoriaId', pm.response.json().id);",
            "pm.collectionVariables.set('categoriaNome', pm.response.json().nome);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Estudos {{$timestamp}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/categorias"
          }
        },
        {
          "name": "Criar categoria com nome repetido (409)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{categoriaNome}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/categorias"
          }
        },
        {
          "name": "Criar categoria sem nome (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"   \"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/categorias"
          }
        },
        {
          "name": "Listar categorias (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Retorna uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/categorias" }
        },
        {
          "name": "Buscar categoria (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Id correto', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('categoriaId'))));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/categorias/{{categoriaId}}" }
        },
        {
          "name": "Editar categoria (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Nome alterado', () => pm.expect(pm.response.json().nome).to.match(/^Faculdade /));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Faculdade {{$timestamp}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/categorias/{{categoriaId}}"
          }
        }
      ]
    },
    {
      "name": "2. Tarefas",
      "item": [
        {
          "name": "Criar tarefa com categoria (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Header Location presente', () => pm.response.to.have.header('Location'));",
            "pm.test('Id gerado pelo banco', () => pm.expect(pm.response.json().id).to.be.a('number'));",
            "pm.test('Categoria vinculada', () => pm.expect(pm.response.json().categoria.id).to.eql(Number(pm.collectionVariables.get('categoriaId'))));",
            "pm.collectionVariables.set('id', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Estudar Docker\",\n  \"descricao\": \"Montar o docker-compose com MySQL\",\n  \"status\": \"EM_ANDAMENTO\",\n  \"prioridade\": \"ALTA\",\n  \"categoria\": { \"id\": {{categoriaId}} }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/tarefas"
          }
        },
        {
          "name": "Criar tarefa só com título (201, valores padrão)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Status padrão PENDENTE', () => pm.expect(pm.response.json().status).to.eql('PENDENTE'));",
            "pm.test('Prioridade padrão MEDIA', () => pm.expect(pm.response.json().prioridade).to.eql('MEDIA'));",
            "pm.test('Sem categoria', () => pm.expect(pm.response.json().categoria).to.eql(null));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Montar a apresentação\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/tarefas"
          }
        },
        {
          "name": "Criar tarefa com categoria inexistente (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Teste\",\n  \"categoria\": { \"id\": 999999 }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/tarefas"
          }
        },
        {
          "name": "Listar tarefas (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Retorna uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/tarefas" }
        },
        {
          "name": "Listar com filtro de status (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Todas com status PENDENTE', () => pm.response.json().forEach(t => pm.expect(t.status).to.eql('PENDENTE')));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/tarefas?status=PENDENTE" }
        },
        {
          "name": "Listar tarefas da categoria (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Contém a tarefa criada', () => pm.expect(pm.response.json().map(t => t.id)).to.include(Number(pm.collectionVariables.get('id'))));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/categorias/{{categoriaId}}/tarefas" }
        },
        {
          "name": "Excluir categoria com tarefas (409)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/categorias/{{categoriaId}}" }
        },
        {
          "name": "Buscar tarefa (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Id correto', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('id'))));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/tarefas/{{id}}" }
        },
        {
          "name": "Editar tarefa (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Status alterado', () => pm.expect(pm.response.json().status).to.eql('CONCLUIDA'));",
            "pm.test('Título mantido', () => pm.expect(pm.response.json().titulo).to.eql('Estudar Docker'));"
          ] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONCLUIDA\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/tarefas/{{id}}"
          }
        },
        {
          "name": "Excluir tarefa (204)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));"
          ] } }],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/tarefas/{{id}}" }
        },
        {
          "name": "Buscar tarefa excluída (404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/tarefas/{{id}}" }
        },
        {
          "name": "Editar tarefa inexistente (404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONCLUIDA\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/tarefas/{{id}}"
          }
        },
        {
          "name": "Criar sem título (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"descricao\": \"sem título\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/tarefas"
          }
        },
        {
          "name": "Criar com status inválido (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Teste\",\n  \"status\": \"FEITO\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/tarefas"
          }
        },
        {
          "name": "Criar com Content-Type errado (415)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 415 Unsupported Media Type', () => pm.response.to.have.status(415));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "text/plain" }],
            "body": { "mode": "raw", "raw": "titulo=Teste", "options": { "raw": { "language": "text" } } },
            "url": "{{baseUrl}}/tarefas"
          }
        },
        {
          "name": "Excluir a coleção inteira (405)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 405 Method Not Allowed', () => pm.response.to.have.status(405));",
            "pm.test('Header Allow presente', () => pm.response.to.have.header('Allow'));"
          ] } }],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/tarefas" }
        }
      ]
    },
    {
      "name": "3. Limpeza",
      "item": [
        {
          "name": "Excluir categoria sem tarefas (204)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));"
          ] } }],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/categorias/{{categoriaId}}" }
        },
        {
          "name": "Buscar categoria excluída (404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/categorias/{{categoriaId}}" }
        }
      ]
    }
  ]
}
