# Copie para .env e ajuste se quiser trocar os padrões do docker-compose.yml:
#   cp .env.example .env
# O .env não vai para o Git (está no .gitignore), porque normalmente guarda senhas.

# Banco e usuário criados no MySQL na primeira inicialização
DB_NAME=tarefas
DB_USER=tarefas
DB_PASSWORD=tarefas
DB_ROOT_PASSWORD=root

# Portas expostas no computador (host)
DB_PORT_HOST=3306
APP_PORT_HOST=8080
